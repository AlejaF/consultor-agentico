{
  "name": "consultor-agentico-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Servicio local opcional de IA real (solo 127.0.0.1). No se despliega.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "11.4.1",
    "@fastify/multipart": "10.1.8",
    "fastify": "5.12.8",
    "mammoth": "1.13.0",
    "openai": "7.55.0",
    "read-excel-file": "9.3.15",
    "unpdf": "2.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "fflate": "0.8.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
