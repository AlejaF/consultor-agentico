# Copia este archivo como `server/.env` y completa los valores EN TU EQUIPO.
# `server/.env` está ignorado por git: nunca lo subas ni pegues su contenido en un chat.
# Las variables van SIN valores aquí (npm run check lo exige). Entre paréntesis, el valor que se usa si la dejas vacía.

# Clave de la API del proveedor (obligatoria para ejecutar el agente real).
OPENAI_API_KEY=

# Modelo de cada etapa. NO hay valor por defecto: lo decide la persona responsable y lo registra en docs/decisiones.md.
OPENAI_MODEL_DIAGNOSTICO=
OPENAI_MODEL_ESTRATEGIA=
OPENAI_MODEL_CRITICO=

# Nivel de razonamiento por etapa (opcional): none, low, medium, high, xhigh o max. Vacío = no se envía.
OPENAI_REASONING_DIAGNOSTICO=
OPENAI_REASONING_ESTRATEGIA=
OPENAI_REASONING_CRITICO=

# Topes (vacío = valor por defecto entre paréntesis).
# Iteraciones máximas del agente (10)
MAX_ITERATIONS=
# Caracteres máximos enviados al modelo por corrida (120000)
MAX_INPUT_CHARS=
# Tokens máximos de salida por llamada (4096, provisional)
MAX_OUTPUT_TOKENS=
# Filas máximas leídas por hoja de XLSX (2000)
MAX_XLSX_ROWS=

# Puerto del servicio, siempre en 127.0.0.1 (8787)
PORT=
# Orígenes permitidos, separados por comas (http://localhost:5173,http://127.0.0.1:5173)
ALLOWED_ORIGINS=
# openai (por defecto) o fake (solo pruebas: respuestas guionadas, sin gasto)
MODEL_PROVIDER=
