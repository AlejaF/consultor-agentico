{
  "name": "consultor-agentico-demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:server": "tsc --noEmit -p server",
    "typecheck:all": "npm run typecheck && npm run typecheck:server",
    "test": "vitest run tests/unit",
    "test:server": "vitest run tests/server",
    "test:all": "npm run test && npm run test:server",
    "test:e2e": "playwright test && playwright test -c playwright.real.config.ts",
    "test:e2e:real": "playwright test -c playwright.real.config.ts",
    "check": "node scripts/check-names.mjs && node scripts/check-tokens.mjs && node scripts/check-secrets.mjs",
    "check:all": "npm run typecheck:all && npm run test:all && npm run check",
    "dev:server": "npm run dev --prefix server",
    "dev:all": "node scripts/dev-all.mjs"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
